DATABASE_URL=postgres://joe:joe@localhost:5433/joe
AUTH_MOCK=admin

# Gateway de pagamento (Mercado Pago, Orders API) — opcional, só precisa pra "Gerar cobrança Pix" em
# Pedidos e pro webhook de confirmação (ver apps/api/src/services/mercadoPago.ts). Sem isso, a tela
# funciona normal, só o botão de Pix dá "não configurado" (501).
# Access token de TESTE/sandbox em https://www.mercadopago.com.br/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=
# Segredo de assinatura do webhook, no mesmo painel (Webhooks → Assinatura secreta).
MERCADOPAGO_WEBHOOK_SECRET=
