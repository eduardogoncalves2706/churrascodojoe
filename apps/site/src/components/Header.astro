---
interface Props { appUrl: string }
const { appUrl } = Astro.props;
const links = [
  ['Cardápio', '#cardapio'], ['Combos', '#combos'], ['Como funciona', '#como-funciona'],
  ['Entrega', '#entrega'], ['Onde estamos', '#onde-estamos'], ['Contato', '#contato'],
];
---
<header class="sticky top-0 z-40 bg-bg/95 backdrop-blur border-b border-white/5">
  <div class="max-w-6xl mx-auto flex items-center justify-between gap-4 px-4 h-16">
    <a href="#" class="flex items-center gap-2 shrink-0">
      <img src="/logo.png" alt="Churrasco do Joe" class="h-11 w-11 rounded-full object-cover" />
      <span class="font-display text-xl sm:text-2xl text-cream tracking-wide leading-none">CHURRASCO<br class="sm:hidden" /> <span class="text-primary-hover">DO JOE</span></span>
    </a>

    <nav class="hidden lg:flex items-center gap-6 font-label uppercase text-sm tracking-wide">
      {links.map(([label, href]) => <a href={href} class="text-cream/80 hover:text-primary-hover transition-colors">{label}</a>)}
    </nav>

    <div class="flex items-center gap-2 shrink-0">
      <a href={appUrl} class="hidden sm:inline-flex btn-ghost !min-h-[40px] !px-3 text-xs" aria-label="Área interna">
        🔒 Área interna
      </a>
      <a href={appUrl} class="sm:hidden text-gold text-xl" aria-label="Área interna">🔒</a>
      <button id="menu-toggle" class="lg:hidden text-cream text-2xl leading-none px-1" aria-label="Abrir menu" aria-expanded="false">☰</button>
    </div>
  </div>

  <nav id="menu-mobile" class="hidden lg:hidden flex-col gap-1 px-4 pb-4 font-label uppercase text-sm tracking-wide">
    {links.map(([label, href]) => <a href={href} class="block py-2 border-t border-white/5 text-cream/80">{label}</a>)}
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('menu-mobile');
  toggle?.addEventListener('click', () => {
    const abrindo = menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    menu?.classList.toggle('flex');
    toggle.setAttribute('aria-expanded', String(!!abrindo));
  });
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { menu.classList.add('hidden'); menu.classList.remove('flex'); }));
</script>
