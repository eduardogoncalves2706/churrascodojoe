---
import type { Combo, Produto } from '../lib/api';
import { brl, whatsappUrl } from '../lib/api';
interface Props { combos: Combo[]; whatsapp: string; produtos: Produto[]; aceitaPedidosSite: boolean }
const { combos, whatsapp, produtos, aceitaPedidosSite } = Astro.props;
// Mesma lista fixa de sabor que o sistema interno usa (NovoPedido.tsx) pro grupo de escolha "refrigerante".
const refrigerantes = produtos.filter((p) => p.categoria === 'bebida' && ['Coca', 'Guaraná', 'Pepsi'].includes(p.nome) && p.disponivelHoje);
---
<section id="combos" class="max-w-6xl mx-auto px-4 py-16 sm:py-20">
  <p class="section-kicker">Pra compartilhar</p>
  <h2 class="section-title mt-1 mb-10">Combos</h2>

  <div class="grid gap-6 md:grid-cols-2">
    {combos.map((combo) => {
      const precoMin = Math.min(...combo.variantes.map((v) => v.precoCents));
      const msg = `Olá! Vi o ${combo.nome} no site e queria pedir 🔥`;
      const temRefrigerante = combo.itens.some((i) => i.grupoEscolha === 'refrigerante');
      return (
        <div class="card !p-6 flex flex-col gap-4" data-combo-card data-nome={combo.nome}>
          {combo.imagemKey && <img src={`/${combo.imagemKey}`} alt={combo.nome} loading="lazy" class="w-full h-40 object-cover rounded-md" />}
          <div class="flex items-start justify-between gap-3">
            <h3 class="font-display text-3xl text-gold leading-none">{combo.nome}</h3>
            <span class="chip !border-primary-hover !text-primary-hover shrink-0">{combo.pessoas} pessoas</span>
          </div>

          <p class="text-cream/70 text-sm leading-relaxed">
            Acompanha: {combo.itens.filter((i) => i.nome !== 'Carne escolhida').map((i) => `${i.quantidade === 0.5 ? '1/2' : i.quantidade}x ${i.nome}`).join(' · ')}
          </p>

          {aceitaPedidosSite ? (
            <div class="space-y-2">
              <div class="space-y-1">
                <label class="font-label uppercase text-xs tracking-wider text-gold">Escolha sua carne</label>
                <select data-variante-select>
                  <option value="">Selecione…</option>
                  {combo.variantes.map((v) => <option value={v.id} data-preco={v.precoCents}>{v.carne} — {brl(v.precoCents)}</option>)}
                </select>
              </div>
              {temRefrigerante && (
                <div class="space-y-1">
                  <label class="font-label uppercase text-xs tracking-wider text-gold">Refrigerante</label>
                  <select data-refri-select>
                    {refrigerantes.map((p) => <option value={p.id}>{p.nome}</option>)}
                  </select>
                </div>
              )}
            </div>
          ) : (
            <div>
              <p class="font-label uppercase text-xs tracking-wider text-gold mb-2">Escolha sua carne</p>
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
                {combo.variantes.map((v) => (
                  <div class="rounded-md border border-white/10 bg-bg/40 px-3 py-2 text-center">
                    <p class="font-label uppercase text-xs text-cream/70 leading-tight">Com {v.carne}</p>
                    <p class="font-display text-xl text-primary-hover leading-tight">{brl(v.precoCents)}</p>
                  </div>
                ))}
              </div>
            </div>
          )}

          <div class="flex items-center justify-between gap-3 mt-1 pt-3 border-t border-white/5">
            <p class="text-cream/60 text-xs">A partir de <span class="text-gold font-bold">{brl(precoMin)}</span></p>
            {aceitaPedidosSite
              ? <button type="button" data-add-combo class="btn !min-h-[40px] !px-4 text-sm">Adicionar ao carrinho</button>
              : <a href={whatsappUrl(whatsapp, msg)} target="_blank" rel="noopener" class="btn !min-h-[40px] !px-4 text-sm">Pedir no WhatsApp</a>}
          </div>
        </div>
      );
    })}
  </div>
</section>
