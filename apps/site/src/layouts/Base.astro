---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  whatsapp?: string;
  enderecoTexto?: string | null;
}
const {
  title = 'Churrasco do Joe — Delivery de churrasco em Canoas',
  description = 'Espeto no capricho, do jeito certo. Delivery e retirada de churrasco aos sábados, domingos e feriados em Canoas e região metropolitana. Peça pelo WhatsApp.',
  whatsapp = '5551998869170',
  enderecoTexto = null,
} = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: 'Churrasco do Joe',
  servesCuisine: 'Churrasco gaúcho',
  priceRange: 'R$50 - R$300',
  telephone: `+${whatsapp}`,
  ...(enderecoTexto ? { address: { '@type': 'PostalAddress', streetAddress: enderecoTexto, addressLocality: 'Canoas', addressRegion: 'RS', addressCountry: 'BR' } } : {}),
  openingHoursSpecification: [{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Saturday', 'Sunday'], opens: '11:00', closes: '14:00' }],
  url: Astro.site?.toString(),
};
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0D0A07" />
    <link rel="icon" href="/favicon-64.png" type="image/png" />
    <link rel="apple-touch-icon" href="/logo-192.png" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).toString()} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/logo-512.png', Astro.site).toString()} />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow:wght@400;500;600&family=Barlow+Condensed:wght@600;700&family=Playfair+Display:ital@1&display=swap" rel="stylesheet" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
