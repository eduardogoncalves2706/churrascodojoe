---
import Base from '../layouts/Base.astro';
import { buscarSite } from '../lib/api';

const site = await buscarSite();
const nome = site?.nome || 'Churrasco do Joe';
---
<Base nome={nome} title={`Página não encontrada — ${nome}`}>
  <main class="min-h-[70vh] flex flex-col items-center justify-center text-center px-4 gap-4">
    <img src="/logo.png" alt={nome} class="h-20 w-20 rounded-full" />
    <h1 class="font-display text-5xl text-gold">404</h1>
    {/* Piada de carvão é copy de marca — ajuste ao customizar pra outro tipo de negócio. */}
    <p class="text-cream/70">Essa página saiu pra buscar mais carvão.</p>
    <a href="/" class="btn">Voltar pro início</a>
  </main>
</Base>
