---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Combos from '../components/Combos.astro';
import Cardapio from '../components/Cardapio.astro';
import ComoFunciona from '../components/ComoFunciona.astro';
import Entrega from '../components/Entrega.astro';
import OndeEstamos from '../components/OndeEstamos.astro';
import Parceiros from '../components/Parceiros.astro';
import Instagram from '../components/Instagram.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import WhatsFloat from '../components/WhatsFloat.astro';
import Carrinho from '../components/Carrinho.astro';
import { buscarBairros, buscarCardapio, buscarSite, buscarStatus } from '../lib/api';

const APP_URL = 'https://app.churrascodojoe.com.br';

const [cardapio, site, status, bairros] = await Promise.all([buscarCardapio(), buscarSite(), buscarStatus(), buscarBairros()]);

// Fallback se a API estiver fora no momento do build — o site nunca fica em branco (ver SPEC §7).
const dados = {
  nome: site?.nome || 'Churrasco do Joe',
  produtos: cardapio?.produtos ?? [],
  combos: cardapio?.combos ?? [],
  whatsapp: site?.whatsapp || '5551998867190',
  instagram: site?.instagram || '@churrascodojoe',
  horarioTexto: site?.horarioTexto || 'Sábados, domingos e feriados, das 11h às 14h.',
  endereco: site?.endereco ?? { modo: 'combinado', texto: null, mapsUrl: null },
  cnpj: site?.cnpj ?? null,
  razaoSocial: site?.razaoSocial ?? null,
  regiaoEntregaTexto: site?.regiaoEntregaTexto || 'Canoas e Região Metropolitana',
  faq: site?.faq ?? [],
  parceiros: site?.parceiros ?? [],
  // Config "Aceitar pré-pedidos pelo site" (Configurações → Site público) — liga/desliga o carrinho
  // no site inteiro; desligada por padrão até decidirem ativar (ver docs/checklist-cliente-novo.md).
  aceitaPedidosSite: site?.aceitaPedidosSite ?? false,
  bairros: bairros ?? [],
};
---
<Base nome={dados.nome} whatsapp={dados.whatsapp} enderecoTexto={dados.endereco.texto}>
  <Header nome={dados.nome} appUrl={APP_URL} />
  <Hero nome={dados.nome} status={status} whatsapp={dados.whatsapp} />
  <Combos combos={dados.combos} whatsapp={dados.whatsapp} produtos={dados.produtos} aceitaPedidosSite={dados.aceitaPedidosSite} />
  <Cardapio produtos={dados.produtos} whatsapp={dados.whatsapp} aceitaPedidosSite={dados.aceitaPedidosSite} />
  <ComoFunciona />
  <Entrega regiaoEntregaTexto={dados.regiaoEntregaTexto} whatsapp={dados.whatsapp} />
  <OndeEstamos nome={dados.nome} modo={dados.endereco.modo} texto={dados.endereco.texto} mapsUrl={dados.endereco.mapsUrl} horarioTexto={dados.horarioTexto} />
  <Parceiros parceiros={dados.parceiros} />
  <Instagram instagram={dados.instagram} />
  {dados.faq.length > 0 && <Faq faq={dados.faq} />}
  <Footer
    nome={dados.nome} whatsapp={dados.whatsapp} instagram={dados.instagram} horarioTexto={dados.horarioTexto}
    regiaoEntregaTexto={dados.regiaoEntregaTexto} cnpj={dados.cnpj} razaoSocial={dados.razaoSocial} appUrl={APP_URL}
  />
  <WhatsFloat whatsapp={dados.whatsapp} />
  <Carrinho whatsapp={dados.whatsapp} bairros={dados.bairros} aceitaPedidosSite={dados.aceitaPedidosSite} />
</Base>
